{
  "name": "flashcards",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/*.js tests/*.test.js",
    "test:db": "node --test tests/database/*.test.js",
    "test:browser": "playwright test",
    "bench:replay": "node scripts/bench-replay.mjs",
    "start": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.8",
    "pg": "8.23.1"
  }
}
